* text=auto eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf

# The engine expects CRLF in INI files.
*.ini text eol=crlf
*.sed text eol=crlf

# Map files are INI text with binary LZO payloads: never convert line endings.
*.yrm binary
*.mmx binary
*.map binary
*.mpr binary
*.mix binary
*.png binary
# String tables: UTF-16 payload, generated by tools/csf.py. Never touch.
*.csf binary

# Mass Skirmish's mod.ini is written with LF by tools/build_mass_skirmish.py;
# keep the checkout at LF so a clone reproduces the bytes the SHA256 in
# build-report.txt was taken from.
mod/MassSkirmish/mod.ini text eol=lf
